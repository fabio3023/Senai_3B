{
  "name": "api-produtos-multicamadas",
  "version": "1.0.0",
  "description": "API REST profissional em múltiplas camadas para gerenciamento de produtos.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
