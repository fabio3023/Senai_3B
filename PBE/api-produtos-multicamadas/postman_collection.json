    "name": "API de Produtos Multicamadas",
    "description": "Coleção para testar o CRUD de produtos. Execute primeiro a requisição de criação para preencher automaticamente a variável produtoId usada nas demais operações por ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.id) {",
              "        pm.collectionVariables.set('produtoId', response.data.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"FON-POSTMAN-001\",\n  \"name\": \"Fone de Ouvido Bluetooth\",\n  \"description\": \"Fone sem fio com cancelamento de ruído e autonomia de 30 horas.\",\n  \"category\": \"Eletrônicos\",\n  \"price\": 349.90,\n  \"stock\": 25,\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/produtos",
          "host": [
