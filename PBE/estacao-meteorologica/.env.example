# ==============================================================
# APLICAÇÃO
# ==============================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
REQUEST_BODY_LIMIT=100kb
LOG_LEVEL=info

# Separe múltiplas origens por vírgula. Use * somente em laboratório.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================
# POSTGRESQL LOCAL
# ==============================================================
# Use 127.0.0.1 para conectar diretamente ao PostgreSQL instalado
# neste computador e evitar diferenças de resolução IPv4/IPv6.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_em
DB_MAINTENANCE_NAME=postgres
DB_USER=postgres

# Troque pela senha definida durante a instalação do PostgreSQL.
DB_PASSWORD=postgres

DB_TIMEZONE=-03:00
DB_LOGGING=false
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Em laboratório, a aplicação pode criar o banco db_em e executar
# automaticamente as migrações. O usuário informado precisa ter
# permissão para criar bancos quando DB_AUTO_CREATE=true.
DB_AUTO_CREATE=true
DB_RUN_MIGRATIONS=true
