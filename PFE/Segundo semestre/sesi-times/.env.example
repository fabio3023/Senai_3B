# Caminho relativo à raiz do projeto ou caminho absoluto.
SESI_DB_PATH=data/sesi-times.db

# Credenciais da área administrativa.
ADMIN_EMAIL=admin@escola.exemplo
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Gere um segredo aleatório com pelo menos 32 caracteres.
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-caracteres

# Use true somente quando o site estiver servido por HTTPS.
SESSION_COOKIE_SECURE=false
